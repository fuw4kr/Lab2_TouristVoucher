<?xml version="1.0" encoding="UTF-8"?>
<!-- Three vouchers with values the parser tests know by heart. -->
<TouristVoucher xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:noNamespaceSchemaLocation="tourist-voucher.xsd">

    <Voucher id="v-101">
        <Type>rest</Type>
        <Country>Greece</Country>
        <NumberDaysNights days="8" nights="7"/>
        <Transport>air</Transport>
        <HotelCharacteristic>
            <Stars>4</Stars>
            <Meal>AI</Meal>
            <RoomType>2</RoomType>
            <Tv>true</Tv>
            <AirConditioner>true</AirConditioner>
        </HotelCharacteristic>
        <Cost currency="EUR">
            <Total>1250.00</Total>
            <Service price="420.00">flight</Service>
            <Service price="760.00">hotel</Service>
            <Service price="70.00">transfer</Service>
        </Cost>
    </Voucher>

    <!-- text with line breaks around it, CDATA and booleans written as 1 / 0 -->
